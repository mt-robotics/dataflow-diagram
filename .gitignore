# ── Environment files ──────────────────────────────────────────────────────────
.env
.env.local
.env.development
.env.staging
.env.production
# Keep .env.example (safe to commit — no real values)

# ── Python ─────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
.uv/
# Keep uv.lock (lockfile should be committed)

# ── Node / Next.js ─────────────────────────────────────────────────────────────
node_modules/
.next/
out/
.vercel/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.tsbuildinfo
# Keep pnpm-lock.yaml (lockfile should be committed)

# ── Testing ────────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage/
*.xml
.jest-cache/

# ── Docker ─────────────────────────────────────────────────────────────────────
.dockerignore

# ── IDE ─────────────────────────────────────────────────────────────────────────
.idea/
.vscode/
.claude/
*.swp
*.swo
*.swn

# ── macOS ──────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Logs ───────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Security / Secrets ─────────────────────────────────────────────────────────
*.pem
*.key
*.crt
nginx/ssl/
nginx/logs/

# ── Database backups ───────────────────────────────────────────────────────────
*.sql
!scripts/init-db.sql

# ── Backup files ───────────────────────────────────────────────────────────────
*_bk.*
*_backup.*
*.bak

# ── Archive (keep daily_log.md only) ───────────────────────────────────────────
archive/*
!archive/daily_log.md
!archive/development_notes

# ── Example / learning files (not production code) ─────────────────────────────
*_examples.py
